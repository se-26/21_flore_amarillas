// Primer gesto real del jugador (el mismo que activa el audio):
//  * PC/escritorio  -> pantalla completa (Fullscreen API, fallback silencioso).
//  * Celular/táctil  -> orientacion horizontal si la API esta disponible
//                       (fallback silencioso; "#rotate-hint" avisa en vertical).
// Nunca cambia la resolucion interna ni bloquea el arranque del juego.
function apply_view_reqs() {
    var coarse  = (navigator.maxTouchPoints > 0) ||
                  (window.matchMedia && matchMedia("(pointer: coarse)").matches);
    var android = /Android/i.test(navigator.userAgent || "");

    // Movil: pedir landscape si existe screen.orientation.lock.
    if (coarse && screen.orientation && typeof screen.orientation.lock === "function") {
        try {
            var lp = screen.orientation.lock("landscape");
            if (lp && typeof lp.catch === "function") lp.catch(function () {});
        } catch (e) {}
    }

    // Escritorio (y Android, necesario ademas para que valide el lock
    // landscape): entrar en pantalla completa con la Fullscreen API.
    var wantFS = !coarse || android;
    if (wantFS && document.documentElement &&
        typeof document.documentElement.requestFullscreen === "function" &&
        !document.fullscreenElement) {
        try {
            var fp = document.documentElement.requestFullscreen();
            if (fp && typeof fp.catch === "function") fp.catch(function () {});
        } catch (e) {}
    }

    // Ajustar ya con el tamano de pantalla definitivo (fullscreen/landscape ya
    // solicitados) y, en movil, intentar esconder la barra de direcciones.
    fit_to_viewport();
    if (coarse) collapse_mobile_bars();
}
window.addEventListener("pointerdown", apply_view_reqs, { once : true })
window.addEventListener("keydown",     apply_view_reqs, { once : true })

// ==========================================================================
//  Layout del canvas: el juego es 16:9 (384x216; framebuffer web 768x432).
//  pygbag 0.9.3 ya tiene window_canvas_adjust (via window_resize) que encaja
//  el canvas en el viewport conservando la proporcion de sus atributos
//  width/height, que ahora arrancan en 768x432 (no 1x1). Con eso ya no
//  calcula relacion 1:1 y deja de quedar cuadrado en moviles.
//
//  Lo que falta para que el movil use TODA la pantalla:
//    * pygbag mide con innerWidth/innerHeight (la ventana del navegador),
//      asi que con la barra de direcciones visible el canvas se queda corto
//      y NO termina de cubrir. Aqui se recalcula SIEMPRE con el
//      visualViewport (el area realmente visible) y, ademas, se intenta
//      ocultar la barra de direcciones via scroll (iOS/Android).
//    * la entrada/salida de fullscreen reescribe el CSS del canvas;
//      reencajar justo despues (idempotente: misma vista -> mismo tamano).
//
//  Hook de window_resize: en vez de localizar la funcion global del runtime
//  (cambia de nombre/posicion segun la build y se reasigna), se hace polling
//  barato cada 250ms; cuando window_resize existe se la envuelve una sola vez
//  y cada invocacion (la de custom_site, la del resize de pygame y las de los
//  botones python) termina re-encajando con fit_to_viewport().
// ==========================================================================
function viewport_geometry() {
    var vv = window.visualViewport;
    if (vv && vv.width > 0 && vv.height > 0) {
        return {
            w: vv.width,
            h: vv.height,
            x: vv.pageLeft || 0,
            y: vv.pageTop || 0
        };
    }
    return { w: window.innerWidth || 0, h: window.innerHeight || 0, x: 0, y: 0 };
}

// Encuadra el canvas a 16:9 dentro del area visible REAL (visualViewport),
// centrado, sin deformar. La franja sobrante queda cubierta por el fondo del
// body (extension del cielo del juego). Es barata e idempotente.
var __fit_prev = { x:-999999, y:-999999, w:-1, h:-1 };
function fit_to_viewport() {
    try {
        var canvas = document.getElementById("canvas");
        if (!canvas) return;
        var g = viewport_geometry();
        if (g.w <= 0 || g.h <= 0) return;
        var dw = g.w;
        var dh = Math.floor(dw * 9 / 16);
        if (dh > g.h) {
            dh = g.h;
            dw = Math.floor(dh * 16 / 9);
        }
        // Redondeo SIMETRICO (offset siempre entero PAR) y calculado sobre el
        // centro, de modo que dos estados de viewport que solo difieren en
        // 1px de alto/barra de direcciones produzcan exactamente la misma
        // posicion -> sin "flutter" del canvas entero alrededor del fondo.
        var nx = Math.round(g.x + (g.w - dw) / 2);
        var ny = Math.round(g.y + (g.h - dh) / 2);
        if (nx !== __fit_prev.x || ny !== __fit_prev.y ||
            dw !== __fit_prev.w || dh !== __fit_prev.h) {
            __fit_prev.x = nx; __fit_prev.y = ny;
            __fit_prev.w = dw; __fit_prev.h = dh;
            canvas.style.width  = dw + "px";
            canvas.style.height = dh + "px";
            canvas.style.left   = nx + "px";
            canvas.style.top    = ny + "px";
            canvas.style.position = "absolute";
        }
    } catch (e) {}
}

// Tras cualquier reajuste del runtime (window_resize de pygbag, que corre
// DESPUES de nuestros hooks y reescribe left/width con su propia referencia),
// volver a ser nosotros el unico autor de la posicion del canvas, siempre
// centrado y simetrico sobre el viewport real. Idempotente y barato.
function fit_to_viewport_autoridad() {
    fit_to_viewport();
    setTimeout(fit_to_viewport, 0);
    setTimeout(fit_to_viewport, 90);
    setTimeout(fit_to_viewport, 260);
}
setInterval(fit_to_viewport_autoridad, 1500);

// Intentos (guarnecidos) de ocultar la barra de direcciones movil con scroll.
function collapse_mobile_bars() {
    if (document.fullscreenElement) return;
    try {
        if (window.scrollY === 0) { window.scrollTo(0, 1); }
    } catch (e) {}
    setTimeout(fit_to_viewport, 120);
    setTimeout(fit_to_viewport, 400);
}

function hook_window_resize() {
    if (typeof window_resize === "function" && !window_resize.__fit23) {
        var orig = window_resize;
        var wrapped = function () {
            var r = orig.apply(this, arguments);
            try {
                if (r && typeof r.then === "function") {
                    r.then(fit_to_viewport, fit_to_viewport);
                }
            } catch (e) {}
            fit_to_viewport();
            return r;
        };
        wrapped.__fit23 = true;
        window.window_resize = wrapped;
    }
}
setInterval(hook_window_resize, 250);

function web_refit() {
    try {
        if (typeof window_resize === "function") {
            window_resize();
        }
    } catch (e) {}
}

function web_refit_delayed() {
    setTimeout(web_refit, 50);
    setTimeout(web_refit, 160);
}

window.addEventListener("resize", web_refit, false);
window.addEventListener("orientationchange", function () {
    web_refit_delayed();
    collapse_mobile_bars();
}, false);
window.addEventListener("fullscreenchange", function () {
    web_refit_delayed();
    try { screen.orientation.unlock(); } catch (e) {}
}, false);
if (window.visualViewport) {
    window.visualViewport.addEventListener("resize", function () { fit_to_viewport(); }, false);
    window.visualViewport.addEventListener("scroll", function () { fit_to_viewport(); }, false);
}
// tras el primer gesto (fullscreen en movil/landscape) reajustar
window.addEventListener("pointerdown", function () {
    web_refit_delayed();
    collapse_mobile_bars();
}, { once : true });
window.addEventListener("keydown", web_refit_delayed, { once : true });

// Antes de que el juego dibuje: fijar el tamano correcto desde el primer marco
// (aunque el runtime todavia no haya definido window_resize).
fit_to_viewport();

function show_infobox() {
    infobox.style.display = "block";

    // Measure box
    const w = infobox.offsetWidth;
    const h = infobox.offsetHeight;

    // Center in viewport
    const left = (window.innerWidth - w) / 2;
    const top = (window.innerHeight - h) / 2;

    infobox.style.left = left + "px";
    infobox.style.top = top + "px";
}

